menu "Cikon IoT Supervisor Button Adapter"
    config BUTTON_MAX_COUNT
        int "Maximum number of buttons"
        default 4
        range 1 16
        help
            Maximum number of buttons that can be configured.
            Adjust based on available GPIOs and memory constraints.

    config BUTTON_GPIO_LIST
        string "Button GPIO List (gpio:active_level[:name] tuples, comma-separated)"
        default "0:0"
        help
            Comma-separated list of GPIO:active_level:name entries for buttons.
            Format: "gpio:active_level" or "gpio:active_level:name".
            active_level is 0 (LOW) or 1 (HIGH). name is optional and free-form
            (auto-named as "gpio<N>" if omitted, e.g. "gpio18").
            Example: "0:0,9:0" for two unnamed buttons.
            Example: "18:0:switch_a,19:0:switch_b" for two named buttons.

endmenu
