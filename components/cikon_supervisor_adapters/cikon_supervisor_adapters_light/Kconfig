menu "Cikon IoT Supervisor Light Adapter"

    config LIGHT_MAX_COUNT
        int "Maximum number of lights"
        default 6
        range 1 8
        help
            Maximum number of logical "light" entities. Each light is one physical
            fixture (1-5 GPIO channels: Red/Green/Blue/Cold-white/Warm-white, or a
            single plain on/off relay/switch channel).

    config LIGHT_GPIO_LIST
        string "Light channel list (role+gpio pairs per light, comma-separated)"
        default "R17+G21+B16+C18+W19:Color Strip,W25:Left Strip,W27:Right Strip"
        help
            Comma-separated list of lights. Each light is a '+'-joined set of
            <role><gpio> channel tokens, optionally followed by ":name".

            Roles:
              - R = red
              - G = green
              - B = blue
              - C = cold-white
              - W = warm-white
              - S = plain on/off relay/switch (no PWM/brightness/color)
              - N = addressable strip (WS2812/SK6812), solid color only -
                    exclusive, cannot combine with any other role

            Supported role sets (one token per role):
              - C | W | CW                (white / CCT only)
              - RGB | RGBC | RGBW | RGBCW (color, optionally + white)
              - S                         (on/off only - cannot combine
                                            with any other role)
              - N                         (addressable strip - cannot combine
                                            with any other role)

            S active-level suffix (appended directly to the GPIO number,
            not ':'-separated - ':' is reserved for the trailing light
            name):
              - S<gpio>   -> active-high (default)
              - S<gpio>H  -> active-high (explicit)
              - S<gpio>L  -> active-low

            N<gpio>x<count>[<format>] suffix (LED count is required; color
            format is optional, defaults to grb):
              - N<gpio>x<count>       -> WS2812, GRB order (most common)
              - N<gpio>x<count>rgb    -> WS2812, RGB order
              - N<gpio>x<count>grbw   -> SK6812, GRB + separate white
              - N<gpio>x<count>rgbw   -> SK6812, RGB + separate white
            Even "plain" WS2812 strips vary in channel order between
            batches/clones - grb is a starting guess to verify on the actual
            strip (send a known color and check it comes out right), not a
            given.

            Example:
              "R17+G21+B16+C18+W19:Color Strip,W25:Left Strip,S26L:Porch Bulb,N4x30:Tree"

    config LIGHT_PWM_FREQUENCY
        int "PWM frequency (Hz)"
        default 20000
        range 100 40000
        help
            PWM frequency for light channels (LEDC). Default is at the edge of human
            hearing to avoid audible coil/driver whine at lower frequencies.

    config LIGHT_ENABLE_FADE
        bool "Enable smooth fade transitions"
        default y
        help
            Use LEDC hardware fade for color/brightness/CCT transitions instead of
            snapping to the new value immediately.

    if LIGHT_ENABLE_FADE

        config LIGHT_FADE_TIME_MS
            int "Default fade time (ms)"
            default 200
            range 0 5000
            help
                Default fade duration for color/brightness/CCT transitions.

    endif

    config LIGHT_PERSIST_STATE
        bool "Persist light state across reboots (NVS)"
        default y
        help
            Save brightness/color/CCT to NVS and restore on boot. On/off is only
            restored after a planned restart (cmnd restart/OTA/resetconf) -
            after power loss/panic/watchdog the light stays off.

    config LIGHT_ENABLE_EFFECTS
        bool "Enable addressable strip animation effects"
        default y
        help
            Dedicated FreeRTOS task driving time-based animations on addressable
            (WS2812/SK6812, role N) lights. The task sleeps fully blocked (zero
            CPU) whenever no light is animating, but still permanently reserves
            its stack (~3-4KB RAM) once the device boots. Can be set to n for a
            device with a strip that only ever wants a fixed color, to pay
            nothing extra - light.c then behaves exactly as it does today.
            No effect on pure PWM lights - only compiled in when a role-N
            channel is also configured in LIGHT_GPIO_LIST.

    if LIGHT_ENABLE_EFFECTS

        config LIGHT_EFFECTS_FPS
            int "Addressable effects animation frame rate"
            default 60
            range 10 120
            help
                Target frame rate for the effects task. WLED's field-proven
                default is 42 (WLED_FPS in their FX.h), used across their whole
                install base from a handful of LEDs to many hundreds - a
                comfortable margin even there. 60 has more headroom for our
                current (short, 30-LED) strips; adjust down for a device with a
                much longer strip (led_strip_refresh time scales with LED count).

    endif

endmenu
