menu "Cikon IoT Supervisor Thread Border Router Adapter"

    config THREAD_BORDER_ROUTER_NETWORK_NAME
        string "Thread network name"
        default "cikon-thread"

    config THREAD_BORDER_ROUTER_CHANNEL
        int "Thread channel (11-26, avoid WiFi ch 1/6/11 overlap)"
        default 15
        range 11 26

    config THREAD_BORDER_ROUTER_WAKEUP_CHANNEL
        int "Wake-up channel for CSL sleepy devices (0 = same as main channel)"
        default 25
        range 0 26

    config THREAD_BORDER_ROUTER_WEB
        bool "Enable Thread Border Router Web GUI"
        default n
        imply VFS_SPIFFS_ENABLED
        help
            Start the ot-br-posix REST API + HTML/JS frontend on port 80.
            Turns on SPIFFS; needs the web_storage partition.

endmenu
