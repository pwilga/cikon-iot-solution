menu "Cikon IoT Thread Radio Configuration"

    config THREAD_RADIO_RCP_UART_PORT
        int "UART port number for RCP"
        depends on OPENTHREAD_RADIO_SPINEL_UART
        default 1
        range 0 2

    config THREAD_RADIO_RCP_TX_PIN
        int "GPIO: host TX → RCP RX"
        depends on OPENTHREAD_RADIO_SPINEL_UART
        default 2
        range 0 48

    config THREAD_RADIO_RCP_RX_PIN
        int "GPIO: host RX ← RCP TX"
        depends on OPENTHREAD_RADIO_SPINEL_UART
        default 1
        range 0 48

    config THREAD_RADIO_RCP_BAUD
        int "UART baud rate for RCP"
        depends on OPENTHREAD_RADIO_SPINEL_UART
        default 460800

    config THREAD_TELE_COUNTERS
        bool "Counters and link quality in the Thread tele"
        default y
        help
            Adds the objects mac, mle, ip, buffers (and br on a border router) and the RSSI of the
            parent to the tele "thread": frames sent and received, retries and failed channel
            checks, the message buffer pool. Building the tele takes a few KB of heap for a moment,
            so a device short on memory can leave it out.

endmenu
