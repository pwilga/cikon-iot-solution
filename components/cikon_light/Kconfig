menu "Cikon IoT Light Driver"

    # Which lights this device drives is not configured here: it lives in the device profile, as
    # devices/<profile>/config/cikon_light/lights.toml, and becomes a C table at build time. Pins
    # are wiring rather than a setting, and a mistake in them should fail the build.

    config LIGHT_PWM_FREQUENCY
        int "PWM frequency (Hz)"
        default 20000
        range 100 40000
        help
            PWM frequency for light channels (LEDC). Default is at the edge of human
            hearing to avoid audible coil/driver whine at lower frequencies.

    config LIGHT_ENABLE_FADE
        bool "Enable smooth fade transitions"
        default y
        help
            Use LEDC hardware fade for color/brightness/CCT transitions instead of
            snapping to the new value immediately.

    if LIGHT_ENABLE_FADE

        config LIGHT_FADE_TIME_MS
            int "Default fade time (ms)"
            default 200
            range 0 5000
            help
                Default fade duration for color/brightness/CCT transitions.

    endif

    config LIGHT_PERSIST_STATE
        bool "Persist light state across reboots (NVS)"
        default y
        help
            Save brightness/color/CCT to NVS and restore on boot. On/off is only
            restored after a planned restart (cmnd restart/OTA/resetconf) -
            after power loss/panic/watchdog the light stays off.

    config LIGHT_ENABLE_EFFECTS
        bool "Enable addressable strip animation effects"
        default y
        help
            Dedicated FreeRTOS task driving time-based animations on addressable
            (WS2812/SK6812, role N) lights. The task sleeps fully blocked (zero
            CPU) whenever no light is animating, but still permanently reserves
            its stack (~3-4KB RAM) once the device boots. Can be set to n for a
            device with a strip that only ever wants a fixed color, to pay
            nothing extra - light.c then behaves exactly as it does today.
            No effect on pure PWM lights - only compiled in when a role-N
            channel is also configured in LIGHT_GPIO_LIST.

    if LIGHT_ENABLE_EFFECTS

        config LIGHT_EFFECTS_TASK_PRIORITY
            int "Addressable effects task priority"
            default 4
            range 0 24
            help
                Priority of the FreeRTOS task rendering addressable-strip
                animations. Keep it just below the supervisor task
                (CONFIG_SUPERVISOR_TASK_PRIORITY, default 5) so telemetry and
                command dispatch stay responsive while an effect runs. The
                default of 4 is the value this task ran at when it derived its
                priority from the supervisor's directly.

        config LIGHT_EFFECTS_FPS
            int "Addressable effects animation frame rate"
            default 60
            range 10 120
            help
                Target frame rate for the effects task. WLED's field-proven
                default is 42 (WLED_FPS in their FX.h), used across their whole
                install base from a handful of LEDs to many hundreds - a
                comfortable margin even there. 60 has more headroom for our
                current (short, 30-LED) strips; adjust down for a device with a
                much longer strip (led_strip_refresh time scales with LED count).

    endif

endmenu
